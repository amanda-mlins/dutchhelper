# ============================================================
# DutchHelper Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# --- CORS ---
# In production, replace with your real domain.
ALLOWED_ORIGINS=["http://localhost:5173","https://yourdomain.com"]

# --- JWT ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_-hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/
# Authorised redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Database ---
# SQLite for local dev (default). Switch to PostgreSQL for production.
# Production example: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./wordbank.db

# --- Frontend ---
# The public URL of your frontend app. Used for OAuth redirects.
FRONTEND_URL=http://localhost:5173
